---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Card from '@components/Card';
import Socials from '@components/Socials.astro';
import getBlogListPosts from '@utils/getBlogListPosts';
import { SOCIALS } from '@config';

const posts = await getCollection('blog');

const recentPosts = getBlogListPosts(posts);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Aman Mittal <span class="username">@amanhimself</span></h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>
      <div class="hero-intro">
        <p>Hi, I'm Aman, a technical writer and a programmer.</p>
        <p>
          Right now, I am working as a <mark class="highlight"
            >documentation engineer</mark
          > at <a
            href="https://expo.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            ><img
              src="/expo-logo.svg"
              alt=""
              class="inline-icon logo-tile"
              style="--tilt: -6deg"
            /><span class="dotted-link">Expo</span></a
          >, where I turn complicated things using docs-as-code first approach
          to help people build React Native apps.
        </p>
        <p>
          Before Expo, I was a Senior Content Developer at <a
            href="https://vercel.com"
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            ><img
              src="/vercel-logo.svg"
              alt=""
              class="inline-icon logo-tile"
              style="--tilt: 5deg"
            /><span class="dotted-link">Vercel</span></a
          > and a Developer Advocate at <a
            href="https://draftbit.com"
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            ><img
              src="/draftbit-logo.svg"
              alt=""
              class="inline-icon logo-tile"
              style="--tilt: -4deg"
            /><span class="dotted-link">Draftbit</span></a
          >. I've been writing about programming since 2017, with <a
            href="/about#technical-writing"
            class="dotted-link"
            >more than 150 articles across 30+ publications</a
          >.
        </p>
        <p>
          This blog is where I write things down as I figure them out and my
          thoughts. See what I'm up to on my <a href="/now" class="dotted-link"
            >/now</a
          > page, or learn more about me on my <a
            href="/about"
            class="dotted-link">/about</a
          > page.
        </p>
        {
          // only display if at least one social link is enabled
          socialCount > 0 && (
            <div class="social-wrapper">
              <div class="social-links">Social Links:</div>
              <Socials />
            </div>
          )
        }
      </div>

      {
        recentPosts.length > 0 && (
          <section id="recent-posts">
            <div class="section-head">
              <h2>Recent Posts</h2>
              <a href="/blog/" class="section-link">
                all posts →
              </a>
            </div>
            <ul class="mt-6">
              {recentPosts.map(
                ({ data, id }, index) =>
                  index < 15 && (
                    <Card
                      href={`/blog/${id}/`}
                      frontmatter={data}
                      secHeading={false}
                    />
                  )
              )}
            </ul>
          </section>
        )
      }

      <section id="projects">
        <div class="section-head">
          <h2>Apps</h2>
          <a href="/projects/" class="section-link">all apps & projects →</a>
        </div>
        <p class="apps-line">
          I build small apps on the side: <a href="/rht" class="icon-link"
            ><img
              src="/rht-icon.png"
              alt=""
              class="inline-icon"
              style="--tilt: -8deg"
            /><span class="dotted-link">RHT</span></a
          > for building a daily reading habit, <a
            href="/lasttimei"
            class="icon-link"
            ><img
              src="/lasttimei-icon.png"
              alt=""
              class="inline-icon"
              style="--tilt: 7deg"
            /><span class="dotted-link">Last Time I</span></a
          > for tracking when you last did important tasks, and <a
            href="/skillsbar"
            class="icon-link"
            ><img
              src="/skillsbar-icon.png"
              alt=""
              class="inline-icon"
              style="--tilt: -5deg"
            /><span class="dotted-link">SkillsBar</span></a
          > for browsing Claude Code and Codex skills from the macOS menu bar.
        </p>
      </section>
    </section>

    <Footer />
  </main>

  <style>
    @reference "../styles/base.css";
    /* ===== Hero Section ===== */
    #hero {
      @apply pb-8 pt-10;
    }
    #hero h1 {
      @apply my-4 inline-block text-2xl font-bold sm:my-6 sm:text-3xl;
    }
    .hero-intro {
      @apply text-base leading-relaxed;
    }
    .highlight {
      background-color: transparent;
      background-image: linear-gradient(
        to top,
        rgba(var(--color-text-base), 0.16) 30%,
        transparent 30%
      );
      color: inherit;
      font-weight: inherit;
      padding: 0 1px;
    }
    .dotted-link {
      @apply text-skin-accent;
      text-decoration: underline dotted;
      text-underline-offset: 3px;
      text-decoration-thickness: 1.5px;
    }
    .dotted-link[href^='http']::after,
    .icon-link[href^='http'] .dotted-link::after {
      content: '↗';
      display: inline-block;
      margin-left: 0.1em;
      font-size: 0.75em;
      opacity: 0.6;
    }
    .icon-link {
      @apply whitespace-nowrap;
    }
    .inline-icon {
      @apply mx-1 inline-block h-6 w-6 rounded-md align-middle;
      transform: rotate(var(--tilt));
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .logo-tile {
      @apply bg-white p-1 ring-1 ring-black/10;
    }
    .icon-link:hover .inline-icon,
    .icon-link:focus-visible .inline-icon {
      transform: rotate(0) scale(1.2);
    }
    @media (prefers-reduced-motion: reduce) {
      .inline-icon {
        transition: none;
      }
    }
    #hero .rss-link {
      @apply mb-6;
    }
    #hero .rss-icon {
      @apply mb-2 h-6 w-6 scale-110 sm:mb-3 sm:scale-125;
      fill: #f26522;
    }
    #hero p {
      @apply my-2;
    }
    /* @handle rendered as a quiet code token, not a solid slab */
    .username {
      background-color: rgb(var(--color-card));
      color: rgb(var(--color-text-base));
      border: 1px solid rgb(var(--color-border));
      padding: 2px 12px;
      display: inline-block;
      font-size: 1.25rem;
      font-weight: 500;
      border-radius: 6px;
      vertical-align: middle;
      opacity: 0.9;
    }
    .social-wrapper {
      @apply mt-4 flex flex-col sm:flex-row sm:items-center;
    }
    .social-links {
      @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
    }

    /* ===== Featured & Recent Posts Sections ===== */
    #recent-posts {
      @apply pb-8 pt-14;
    }
    #recent-posts h2 {
      @apply text-2xl font-semibold tracking-tight;
    }
    /* ===== Projects Section ===== */
    #projects {
      @apply pb-8 pt-14;
    }
    .section-head {
      @apply flex items-baseline justify-between;
    }
    #projects h2 {
      @apply text-2xl font-semibold tracking-tight;
    }
    .section-link {
      @apply text-xs text-skin-base opacity-60 transition-opacity hover:underline hover:opacity-100;
    }
    #projects .apps-line {
      @apply mt-6 leading-loose;
    }
  </style>
</Layout>
